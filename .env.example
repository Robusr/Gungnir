# Copy to .env and fill in. The LLM layer reads these via gungnir.settings.
# Leave GUNGNIR_LLM_API_KEY empty to run offline (template explanation).

# OpenAI-compatible base URL (DeepSeek by default).
GUNGNIR_LLM_BASE_URL=https://api.deepseek.com/v1

# API key. Empty => the L4 layer degrades to a deterministic template (no network).
GUNGNIR_LLM_API_KEY=

# Model id (DeepSeek V4 / chat model).
GUNGNIR_LLM_MODEL=deepseek-chat
